{
  "name": "streamed-arena",
  "version": "1.8.1",
  "private": true,
  "description": "A live sports streaming arena that hosts the streams itself: its own servers fetch the media ahead of the player and serve it from disk",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/next-dev.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:resolver": "node scripts/resolver-check.mjs",
    "check:personal-server": "node scripts/personal-server-check.mjs",
    "check:media": "node scripts/media-check.mjs",
    "check:sources": "node scripts/sources-check.mjs",
    "check:direct": "node scripts/direct-check.mjs",
    "check:feeds": "node scripts/feed-check.mjs",
    "check:provider": "node scripts/provider-check.mjs",
    "check:mirror": "node scripts/mirror-check.mjs",
    "check:failover": "node scripts/failover-check.mjs",
    "build:exe": "node scripts/build-exe.mjs",
    "installer": "node scripts/make-installer.mjs",
    "sign-binary": "node scripts/sign-binary.mjs",
    "sign-release": "node scripts/sign-release.mjs",
    "release": "npm run build:exe && npm run installer && npm run sign-binary && npm run sign-release"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.48.0",
    "next": "15.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.5",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
